    {
      "id": "l1",
      "start": 0.15,
      "end": 4.653,
      "text": "81 ili plaka sırasıyla gezsen, dünyanın çevresinden daha uzun yol yaparsın."
    },
    {
      "id": "l2",
      "start": 4.933,
      "end": 10.647,
      "text": "01 Adana'dan başla: Adıyaman, Afyon, Ağrı… Daha 4. ilde 2.040 km."
    },
    {
      "id": "l3",
      "start": 10.927,
      "end": 15.341,
      "text": "Neden bu kadar dağınık? Çünkü plakalar haritaya göre değil, ALFABEYE göre verildi."
    },
    {
      "id": "l4",
      "start": 15.871,
      "end": 21.153,
      "text": "35'ten 36'ya: İzmir'den Kars'a, tek hamlede 1.387 km."
    },
    {
      "id": "l5",
      "start": 21.433,
      "end": 24.59,
      "text": "70'te, Karaman'da, dünyanın çevresini geçiyorsun."
    },
    {
      "id": "l6",
      "start": 25.32,
      "end": 26.454,
      "text": "Daha 11 il var."
    },
    {
      "id": "l7",
      "start": 26.934,
      "end": 29.479,
      "text": "Toplam: 46.555 km."
    },
    {
      "id": "l8",
      "start": 30.259,
      "end": 35.982,
      "text": "Aynı 81 il, akıllı sırayla: 6.948 km. Yaklaşık 7 kat kısa."
    },
    {
      "id": "l9",
      "start": 36.262,
      "end": 38.65,
      "text": "Senin ilin bu rotada kaçıncı durak? Durdur, bak."
    }
