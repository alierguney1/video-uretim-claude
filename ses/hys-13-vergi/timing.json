{
  "duration": 36.63,
  "lines": [
    {
      "id": "l1",
      "start": 0.15,
      "end": 3.411,
      "text": "Türkiye'de toplanan verginin yarısından fazlası, tek bir ilden geliyor."
    },
    {
      "id": "l2",
      "start": 3.661,
      "end": 8.144,
      "text": "İstanbul. Geçen yıl, diğer 80 ilin toplamından bile fazla vergi ödedi."
    },
    {
      "id": "l3",
      "start": 8.394,
      "end": 11.061,
      "text": "İlk beş ili ekle: verginin %81'i."
    },
    {
      "id": "l4",
      "start": 11.311,
      "end": 14.616,
      "text": "Ama dikkat: vergi, şirketin kayıtlı olduğu ilde sayılıyor."
    },
    {
      "id": "l5",
      "start": 14.866,
      "end": 16.364,
      "text": "Peki bu para, nerede harcanıyor?"
    },
    {
      "id": "l6",
      "start": 16.614,
      "end": 20.149,
      "text": "81 ilin 72'si, topladığı vergiden fazla harcama alıyor."
    },
    {
      "id": "l7",
      "start": 20.399,
      "end": 23.926,
      "text": "En uçta Hakkari: 1 liralık vergiye, 16 lira harcama."
    },
    {
      "id": "l8",
      "start": 24.176,
      "end": 26.919,
      "text": "İstanbul'da ise 100 liralık vergiye, 11 lira."
    },
    {
      "id": "l9",
      "start": 27.169,
      "end": 32.122,
      "text": "Bir de şu var: harcamanın %60'ı, faiz ve transferler gibi, hiçbir ile yazılmıyor."
    },
    {
      "id": "l10",
      "start": 32.372,
      "end": 34.427,
      "text": "Senin ilin kaç kat alıyor? Durdur, bul."
    }
  ]
}